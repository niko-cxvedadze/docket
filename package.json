{
  "name": "docket",
  "version": "0.2.0",
  "description": "Desktop dashboard for pull requests that need you, with AI-drafted code reviews",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "electron-vite build && electron-builder --mac --publish never"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.71.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4",
    "recharts": "3.8.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "author": "niko-cxvedadze",
  "homepage": "https://github.com/niko-cxvedadze/docket",
  "build": {
    "appId": "com.github.niko-cxvedadze.docket",
    "productName": "Docket",
    "files": [
      "out/**",
      "package.json",
      "!node_modules/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "Docket-${version}-${arch}.${ext}",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "Docket ${version}"
    }
  }
}
